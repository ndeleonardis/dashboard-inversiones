# Configuración de cada copia de LemonHouse.
# Copiá este archivo a .env.development (proyecto de desarrollo) o a
# .env.production (proyecto real) y completá los valores. Esos archivos
# no se versionan. Este, sin valores, sí.

# URL del proyecto de Supabase.
VITE_SUPABASE_URL=
# Key publicable del proyecto. Llega al navegador, así que no es un secreto.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Para subir las migraciones y generar los tipos (npm run db:subir y
# npm run db:tipos). No llegan al navegador.
# Ref del proyecto: lo que va antes de .supabase.co en la URL.
SUPABASE_PROJECT_ID=
# Contraseña de la base, la que se eligió al crear el proyecto.
SUPABASE_DB_PASSWORD=
# Token personal de la CLI de Supabase (Account, Access Tokens).
SUPABASE_ACCESS_TOKEN=

# Para publicar (npm run publicar). Solo en .env.production.
# Servidor y carpeta donde Nginx sirve la app, como los escribe scp:
# usuario@servidor:/var/www/lemonhouse
PUBLICAR_DESTINO=
