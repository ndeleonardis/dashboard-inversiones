# Configuración de cada copia de LemonHouse.
# Copiá este archivo a .env.development (proyecto de desarrollo) o a
# .env.production (proyecto real) y completá los valores. Esos archivos
# no se versionan. Este, sin valores, sí.

# URL del proyecto de Supabase.
VITE_SUPABASE_URL=
# Key publicable del proyecto. Llega al navegador, así que no es un secreto.
VITE_SUPABASE_PUBLISHABLE_KEY=
